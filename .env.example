# Copy to .env locally. Never commit secrets.
# MVP is paper-only. Live trading is not implemented.

ALEXRAG_MODE=paper
ALEXRAG_KILL_SWITCH=false
ALEXRAG_FAIL_CLOSED=true

# Retrieval fail-closed
ALEXRAG_MIN_RETRIEVAL_CONFIDENCE=0.2
ALEXRAG_STALE_AFTER_HOURS=36

# Paper promotion window (gate-driven, not a calendar date)
ALEXRAG_MIN_PAPER_SESSIONS=60
ALEXRAG_MIN_PAPER_DECISIONS=100

# Nishant-locked operator hard limits (pcts of paper equity).
# Dollar notional / daily-loss = paper.nav * pct at runtime.
# paper.nav 0 fail-closes go-decisions (cannot derive dollars).
ALEXRAG_MAX_NOTIONAL_PCT=1.5
ALEXRAG_MAX_POSITIONS=15
ALEXRAG_MAX_DAILY_LOSS_PCT=0.10
ALEXRAG_MAX_PORTFOLIO_DD=0.25
ALEXRAG_NOTIONAL_BREACH_POLICY=pro_rata_trim_for_new_entry
ALEXRAG_PAPER_NAV=0

ALEXRAG_AUDIT_LOG_PATH=data/audit/events.jsonl
# Fixture/doctrine files only — there is no local GitBook mirror.
ALEXRAG_GITBOOK_PATH=data/gitbook

# --- TODOs: do not fill in git ---
# Inferhub (no secrets in repo). Upstream provider is locked to cbcn.
# Model id is provider-prefixed. Do not route to any other Inferhub upstream.
# Key via env only — never commit the key.
LLM_PROVIDER=inferhub
LLM_MODEL=cbcn/GLM-5.3-flash
INFERHUB_BASE_URL=https://api.inferhub.dev/v1
INFERHUB_PROVIDER=cbcn

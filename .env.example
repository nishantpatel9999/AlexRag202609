# Copy to .env locally. Never commit secrets.
# MVP is paper-only. Live trading is not implemented.

ALEXRAG_MODE=paper
ALEXRAG_KILL_SWITCH=false
ALEXRAG_FAIL_CLOSED=true

# Retrieval fail-closed
ALEXRAG_MIN_RETRIEVAL_CONFIDENCE=0.2
ALEXRAG_STALE_AFTER_HOURS=36

# Paper promotion window (gate-driven, not a calendar date)
ALEXRAG_MIN_PAPER_SESSIONS=60
ALEXRAG_MIN_PAPER_DECISIONS=100

# Hard limits (operator-set). 0 blocks any positive paper size (fail-closed).
ALEXRAG_MAX_NOTIONAL=0
ALEXRAG_MAX_POSITIONS=0
ALEXRAG_MAX_DAILY_LOSS=0
ALEXRAG_MAX_PORTFOLIO_DD=0

ALEXRAG_AUDIT_LOG_PATH=data/audit/events.jsonl
ALEXRAG_GITBOOK_PATH=data/gitbook

